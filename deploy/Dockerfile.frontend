FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
COPY tsconfig.base.json eslint.config.js ./
ARG APP=@regent/tenant-dashboard
ARG NGINX_CONF=deploy/nginx-spa.conf
RUN corepack pnpm install --frozen-lockfile
RUN corepack pnpm --filter "${APP}" build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS final
ARG HTML_DIR=apps/tenant-dashboard/dist
ARG NGINX_CONF=deploy/nginx-spa.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY --from=build /app/${HTML_DIR} /usr/share/nginx/html
EXPOSE 80
