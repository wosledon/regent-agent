            "type": "string"
          }
        }
      },
      "EmployeeState": {
        "enum": [
          "active",
          "busy",
          "sleeping",
          "rate_limited",
          "degraded",
          "unavailable",
          "pending_review",
          "frozen",
          "terminated"
        ]
      },
      "EmployeeSummary": {
        "required": [
          "id",
          "employeeNo",
          "displayName",
          "position",
          "state",
          "stateReason",
          "freshness"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeNo": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/EmployeeState"
          },
          "stateReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        }
      },
      "EmployeeTimeline": {
        "required": [
          "employee",
          "entries",
          "generatedAt"
