  "components": {
    "schemas": {
      "ActionCenterItem": {
        "required": [
          "id",
          "sourceType",
          "title",
          "severity",
          "owner",
          "createdAt",
          "slaDueAt",
          "requiresBossDecision",
          "nextAction",
          "href"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "owner": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "slaDueAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "requiresBossDecision": {
            "type": "boolean"
          },
          "nextAction": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      },
      "ApprovalDecision": {
        "required": [
          "decision",
          "reason"
        ],
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ApprovalDto": {
        "required": [
          "id",
          "actionType",
          "title",
          "impact",
          "severity",
          "state",
          "requester",
          "createdAt",
          "expiresAt",
          "options",
          "evidenceRefs"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actionType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "state": {
            "$ref": "#/components/schemas/ApprovalState"
          },
          "requester": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApprovalState": {
        "enum": [
          "pending",
          "approved",
          "rejected",
          "expired"
        ]
      },
      "ComplianceProfile": {
        "required": [
          "tenantId",
          "preset",
          "allowedProviders",
          "allowedRegions",
          "onlineRetentionDays",
          "auditProfile",
          "backupRequired",
          "externalSharingAllowed",
          "version",
          "status"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "allowedProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedRegions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "onlineRetentionDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "auditProfile": {
            "type": "string"
          },
          "backupRequired": {
            "type": "boolean"
          },
          "externalSharingAllowed": {
            "type": "boolean"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CorrectMemoryRequest": {
        "required": [
          "content",
          "reason"
        ],
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CreateReviewRequest": {
        "required": [
          "employeeId",
          "conclusion",
          "evidenceJson"
        ],
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          },
          "evidenceJson": {
            "type": "string"
          }
        }
      },
      "DashboardCard": {
        "required": [
          "id",
          "title",
          "summary",
          "metric",
          "severity",
          "freshness",
          "dataAt",
          "href"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "metric": {
            "type": [
              "null",
              "string"
            ]
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          },
          "dataAt": {
            "type": "string",
            "format": "date-time"
          },
          "href": {
            "type": "string"
          }
        }
      },
      "DashboardSummary": {
        "required": [
          "companyName",
          "companyStatus",
          "cards",
          "actions",
          "generatedAt"
        ],
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string"
          },
          "companyStatus": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardCard"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionCenterItem"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DevLoginRequest": {
        "required": [
