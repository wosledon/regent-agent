        "type": "object",
        "properties": {
          "employee": {
            "$ref": "#/components/schemas/EmployeeSummary"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployeeWorkEntry"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EmployeeWorkEntry": {
        "required": [
          "id",
          "occurredAt",
          "taskId",
          "title",
          "eventType",
          "status",
          "nextAction",
          "costMinor",
          "currency",
          "evidenceRefs"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
