{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "Profile": "local",
    "Signals": { "Metrics": false, "Logs": true, "Traces": false },
    "Sampling": 0.1,
    "Redaction": "strict",
    "OtlpEndpoint": "",
    "ServiceName": "regent-gateway",
    "ServiceVersion": "local"
  },
  "Gateway": {
    "ProviderMode": "local",
    "MonthlyLimit": 8000000,
    "UsagePath": "data/gateway-usage.jsonl",
    "KeyVaultPath": "data/keyvault.json",
    "MasterKeyPath": "data/secrets/master.key",
    "Providers": {
      "OpenAI": {
        "BaseUrl": "https://api.openai.com/v1",
        "TimeoutSeconds": 120,
        "MaxResponseBytes": 4194304,
        "MaxRetries": 2,
        "BaseDelayMilliseconds": 200
      },
      "Anthropic": {
        "BaseUrl": "https://api.anthropic.com/v1",
        "TimeoutSeconds": 120,
        "MaxResponseBytes": 4194304,
        "MaxRetries": 2,
        "BaseDelayMilliseconds": 200
      }
    }
  }
}
