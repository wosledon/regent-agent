{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "Profile": "local",
    "Signals": { "Metrics": false, "Logs": true, "Traces": false },
    "Sampling": 0.1,
    "Redaction": "strict",
    "OtlpEndpoint": "",
    "ServiceName": "regent-gateway",
    "ServiceVersion": "local"
  },
  "AgentIdentity": {
    "Issuer": "regent-control",
    "Audience": "regent-agent",
    "GatewayAudience": "regent-gateway",
    "LifetimeMinutes": 15,
    "ClockSkewSeconds": 60,
    "KeyPath": "data/secrets/agent-token.key"
  },
  "Gateway": {
    "ProviderMode": "local",
    "AdminToken": "",
    "MonthlyLimit": 800000,
    "BudgetCurrency": "CNY",
    "BudgetPath": "data/gateway-budget.json",
    "UsagePath": "data/gateway-usage.jsonl",
    "Pricing": {
      "MinorUnitFactor": 100,
      "SafetyMarginBasisPoints": 1000,
      "Models": []
    },
    "KeyVaultPath": "data/keyvault.json",
    "MasterKeyPath": "data/secrets/master.key",
    "KeyVault": {
      "Provider": "local",
      "ConnectionString": "",
      "Schema": "keyvault",
      "Table": "model_keys",
      "CommandTimeoutSeconds": 15,
      "RequireTls": true
    },
    "Providers": {
      "OpenAI": {
        "BaseUrl": "https://api.openai.com/v1",
        "TimeoutSeconds": 120,
        "MaxResponseBytes": 4194304,
        "MaxRetries": 2,
        "BaseDelayMilliseconds": 200
      },
      "Anthropic": {
        "BaseUrl": "https://api.anthropic.com/v1",
        "TimeoutSeconds": 120,
        "MaxResponseBytes": 4194304,
        "MaxRetries": 2,
        "BaseDelayMilliseconds": 200
      }
    }
  }
}
