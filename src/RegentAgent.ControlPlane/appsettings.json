{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Sqlite",
    "UseInMemory": false,
    "ObjectRoot": "data/objects",
    "ObjectProvider": "Local",
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "Region": "us-east-1",
      "Bucket": "regent-artifacts",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true,
      "TimeoutSeconds": 120,
      "MaxRetries": 2
    }
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=data/regent.db",
    "Postgres": "Host=localhost;Port=5432;Database=regent;Username=regent;Password=regent_dev_only"
  },
  "ModelCatalog": {
    "Mode": "local",
    "ModelsDevUrl": "https://models.dev/api.json",
    "TimeoutSeconds": 30,
    "MaxResponseBytes": 16777216,
    "MaxRetries": 2,
    "BaseDelayMilliseconds": 200
  },
  "Frontend": {
    "Origins": ["http://localhost:5173", "http://localhost:4173"]
  }
}
